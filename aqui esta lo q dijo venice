"""Agregación: actualización sin duplicar, prioridad de estados, caducidad."""
from __future__ import annotations

import asyncio
import time
from collections import deque
from decimal import Decimal

from config import Config
from models import ServerRecord, ServerState, STATE_RANK, Verification


class Aggregator:
    def __init__(self, cfg: Config):
        self.cfg = cfg
        self._records: dict[str, ServerRecord] = {}
        self.history: deque[dict] = deque(maxlen=cfg.history_limit)
        self.on_change = None
        self.on_expire = None
        self.stats = {
            "servers_seen": 0, "servers_evaluated": 0, "findings": 0,
            "confirmed": 0, "duplicates": 0, "expired": 0,
            "rate_limited": 0, "http_errors": 0, "invalid_rows": 0,
            "started_at": time.time(),
        }
        self._lock = asyncio.Lock()

    # ---------- contadores ----------
    def count_seen(self, n: int) -> None:
        self.stats["servers_seen"] += max(0, n)

    def count_rate_limited(self) -> None:
        self.stats["rate_limited"] += 1

    # ---------- consulta ----------
    def get(self, job_id: str) -> ServerRecord | None:
        return self._records.get(job_id)

    def get_active(self, job_id: str) -> ServerRecord | None:
        record = self._records.get(job_id)
        if record is None or record.state is ServerState.EXPIRED:
            return None
        return record

    def active(self) -> list[ServerRecord]:
        return [r for r in self._records.values() if r.state is not ServerState.EXPIRED]

    def snapshot(self, limit: int = 60, confirmed_only: bool = False,
                 min_value: Decimal | None = None) -> list[dict]:
        items = self.active()
        if confirmed_only:
            items = [r for r in items if r.verification is Verification.CONFIRMED]
        if min_value is not None:
            items = [r for r in items if r.value is not None and r.value >= min_value]
        items.sort(key=lambda r: (
            r.verification is Verification.CONFIRMED,
            float(r.value or 0),
            r.score,
            r.updated_at,
        ), reverse=True)
        return [r.to_dict() for r in items[:limit]]

    def ui_stats(self) -> dict:
        active = self.active()
        return {
            "servers_seen": self.stats["servers_seen"],
            "servers_evaluated": self.stats["servers_evaluated"],
            "candidates": sum(1 for r in active if r.state is ServerState.CANDIDATE),
            "unavailable": sum(1 for r in active if r.state is ServerState.UNAVAILABLE),
            "unknown_verification": sum(1 for r in active if r.verification is Verification.UNKNOWN),
            "confirmed": sum(1 for r in active if r.verification is Verification.CONFIRMED),
            "expired": self.stats["expired"],
            "duplicates": self.stats["duplicates"],
            "rate_limited": self.stats["rate_limited"],
            "http_errors": self.stats["http_errors"],
            "invalid_rows": self.stats["invalid_rows"],
            "uptime_s": int(time.time() - self.stats["started_at"]),
        }

    # ---------- ingesta ----------
    async def ingest(self, incoming: ServerRecord) -> ServerRecord:
        async with self._lock:
            current = self._records.get(incoming.job_id)
            if current is None:
                self._records[incoming.job_id] = incoming
                self.stats["servers_evaluated"] += 1
                if incoming.state in (ServerState.CANDIDATE, ServerState.CONFIRMED):
                    self.stats["findings"] += 1
                if incoming.verification is Verification.CONFIRMED:
                    self.stats["confirmed"] += 1
                self._remember(incoming)
                notify = True
            else:
                self.stats["duplicates"] += 1
                notify = self._merge(current, incoming)
            if len(self._records) > 600:
                self._evict_oldest()
            result = self._records[incoming.job_id]
        if notify and self.on_change:
            await self.on_change(result, result)
        return result

    def _merge(self, current: ServerRecord, incoming: ServerRecord) -> bool:
        prev_state = current.state
        prev_occ = current.occupancy

        current.playing = incoming.playing
        current.max_players = incoming.max_players
        current.ping = incoming.ping
        current.fps = incoming.fps
        current.score = incoming.score
        current.updated_at = incoming.updated_at
        current.latency_ms = incoming.latency_ms

        if current.verification is Verification.CONFIRMED:
            if current.state is not ServerState.CONFIRMED:
                current.state = ServerState.CONFIRMED
                self._remember(current)
                return True
            return current.occupancy is not prev_occ

        if STATE_RANK[incoming.state] >= STATE_RANK[current.state] or current.state is ServerState.EXPIRED:
            current.state = incoming.state
            if incoming.verification is Verification.CONFIRMED:
                current.verification = Verification.CONFIRMED
                current.eggs = incoming.eggs
                current.value = incoming.value
                current.confirmed_at = incoming.confirmed_at
                self.stats["confirmed"] += 1
            if current.state is ServerState.CANDIDATE and prev_state is not ServerState.CANDIDATE:
                self.stats["findings"] += 1
            if current.state != prev_state:
                self._remember(current)
                return True
        return current.occupancy is not prev_occ

    async def confirm(self, job_id: str, eggs, value: Decimal) -> ServerRecord:
        async with self._lock:
            record = self._records.get(job_id)
            if record is None:
                record = ServerRecord(job_id=job_id, place_id=self.cfg.place_id,
                                      state=ServerState.CONFIRMED)
                self._records[job_id] = record
                self.stats["servers_evaluated"] += 1
            was = record.verification is Verification.CONFIRMED
            record.eggs = eggs
            record.value = value
            record.verification = Verification.CONFIRMED
            record.state = ServerState.CONFIRMED
            record.confirmed_at = time.time()
            record.updated_at = time.time()
            if not was:
                self.stats["confirmed"] += 1
                self.stats["findings"] += 1
            self._remember(record)
        if self.on_change:
            await self.on_change(record, record)
        return record

    async def expire_sweep(self) -> list[str]:
        now = time.time()
        expired: list[str] = []
        async with self._lock:
            for job_id, record in list(self._records.items()):
                ttl = self.cfg.confirmed_ttl_s if record.verification is Verification.CONFIRMED else self.cfg.record_ttl_s
                if now - record.updated_at > ttl and record.state is not ServerState.EXPIRED:
                    record.state = ServerState.EXPIRED
                    expired.append(job_id)
                    self.stats["expired"] += 1
            for job_id, record in list(self._records.items()):
                if record.state is ServerState.EXPIRED and now - record.updated_at > self.cfg.confirmed_ttl_s * 3:
                    self._records.pop(job_id, None)
        if expired and self.on_expire:
            await self.on_expire(expired)
        return expired

    def _remember(self, record: ServerRecord) -> None:
        self.history.appendleft({
            "job_id": record.job_id, "state": record.state.value,
            "verification": record.verification.value,
            "value": str(record.value) if record.value is not None else None,
            "at": time.time(),
        })

    def _evict_oldest(self) -> None:
        oldest = sorted(self._records.values(), key=lambda r: r.updated_at)[:100]
        for record in oldest:
            if record.verification is not Verification.CONFIRMED:
                self._records.pop(record.job_id, None)

    def clear(self) -> None:
        self._records.clear()
        self.history.clear()
