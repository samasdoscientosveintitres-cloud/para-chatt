"""Punto de entrada único: valida, arranca y apaga."""
from __future__ import annotations

import argparse
import logging
import socket
import sys

import uvicorn

from config import Config, ConfigError, setup_logging, validate_port
from server import create_app

log = logging.getLogger("sniper.main")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="steal-a-egg-sniper",
                                     description="Descubridor de instancias de Steal An Egg")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8710)
    parser.add_argument("--workers", type=int, default=None)
    parser.add_argument("--min-value", default=None)
    parser.add_argument("--rps", type=float, default=None)
    parser.add_argument("--no-discovery", action="store_true", help="no lanzar workers")
    parser.add_argument("--log-level", default="info", choices=["debug", "info", "warning", "error"])
    return parser


def validate_host(host: str) -> str:
    if host in ("localhost", "::1", "[::1]"):
        return "127.0.0.1"
    try:
        if host.count(".") == 3:
            socket.inet_aton(host)
        else:
            socket.inet_pton(socket.AF_INET6, host)
    except OSError:
        raise SystemExit(f"error: host inválido: {host!r}")
    return host


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    setup_logging(getattr(logging, args.log_level.upper()))

    try:
        validate_port(args.port)
    except ConfigError as exc:
        raise SystemExit(f"error: {exc}")
    host = validate_host(args.host)

    cfg = Config.load()

    if args.workers is not None:
        clamped = max(1, min(100, args.workers))
        if clamped != args.workers:
            log.warning("--workers %d ajustado a %d", args.workers, clamped)
        cfg.workers = clamped
    if args.min_value is not None:
        cfg.min_value = args.min_value
    if args.rps is not None:
        cfg.requests_per_second = args.rps
    if args.no_discovery:
        cfg.enable_discovery = False

    try:
        cfg.validate()
    except ConfigError as exc:
        raise SystemExit(f"error de configuración: {exc}")

    try:
        cfg.save()
    except OSError as exc:
        log.warning("no se pudo guardar la configuración (%s); se continúa en memoria", exc)

    app = create_app(cfg, host)
    log.info("panel en http://%s:%d/ (workers=%d, rps=%.1f, concurrencia=%d)",
             host, args.port, cfg.workers, cfg.requests_per_second, cfg.max_concurrency)
    if host != "127.0.0.1":
        log.info("fuera de loopback: los endpoints mutantes exigen X-Local-Token")
    try:
        uvicorn.run(app, host=host, port=args.port, log_level=args.log_level)
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
