"""Ingestión de evidencia externa. Autocontenido: devuelve sus propios errores."""
from __future__ import annotations

import time
from collections import deque

from fastapi import APIRouter, Header, Request
from fastapi.responses import JSONResponse
from pydantic import BaseModel, Field

from models import Egg, is_job_id
from value_parser import parse_value

MAX_BODY = 32 * 1024
MAX_EGGS = 32
MAX_NAME = 48


class EggIn(BaseModel):
    name: str = Field(min_length=1, max_length=MAX_NAME)
    value: str = Field(min_length=1, max_length=24)


class ReportIn(BaseModel):
    job_id: str = Field(min_length=36, max_length=36)
    place_id: int
    eggs: list[EggIn] = Field(min_length=1, max_length=MAX_EGGS)


def _error(status: int, code: str, message: str) -> JSONResponse:
    return JSONResponse({"error": {"code": code, "message": message}}, status_code=status)


def build_router(ctx) -> APIRouter:
    """ctx expone cfg, detector, aggregator, notifier."""
    router = APIRouter()
    hits: deque[float] = deque(maxlen=1000)

    @router.post("/api/bridge/report")
    async def report(body: ReportIn, request: Request, x_bridge_token: str = Header(default="")):
        if not ctx.cfg.bridge_enabled:
            return _error(503, "bridge_disabled", "el puente está desactivado")
        length = int(request.headers.get("content-length") or 0)
        if length > MAX_BODY:
            return _error(413, "too_large", f"cuerpo mayor de {MAX_BODY} bytes")
        if x_bridge_token != ctx.cfg.bridge_token:
            return _error(401, "bad_token", "token de puente inválido")

        now = time.time()
        while hits and now - hits[0] > 60:
            hits.popleft()
        if len(hits) >= ctx.cfg.bridge_rate_per_min:
            return _error(429, "rate_limited", "demasiados informes por minuto")
        hits.append(now)

        if body.place_id != ctx.cfg.place_id:
            return _error(422, "bad_place", f"place_id {body.place_id} != {ctx.cfg.place_id}")
        if not is_job_id(body.job_id):
            return _error(422, "bad_job", "job_id no es un UUID válido")

        eggs: list[Egg] = []
        rejected = 0
        for item in body.eggs:
            parsed = parse_value(item.value)
            if parsed is None:
                rejected += 1
                continue
            eggs.append(Egg(item.name.strip()[:MAX_NAME], parsed))
        if not eggs:
            return _error(422, "no_valid_eggs", "ningún valor interpretable")

        best = max(eggs, key=lambda e: e.value)
        if best.value < ctx.cfg.min_value_decimal:
            return JSONResponse({"ok": True, "confirmed": False, "accepted": len(eggs),
                                 "best": str(best.value), "reason": "por debajo del umbral"})

        if not ctx.detector.register_report(body.job_id, eggs):
            return _error(422, "not_accepted", "informe no aceptado")

        record = await ctx.aggregator.confirm(body.job_id, eggs, best.value)
        ctx.notifier.publish("bridge", {
            "job_id": body.job_id, "eggs": len(eggs), "best": str(best.value),
            "known": True,
        })
        return JSONResponse({"ok": True, "confirmed": True, "accepted": len(eggs),
                             "rejected": rejected, "best": str(best.value),
                             "known": record is not None})

    return router
