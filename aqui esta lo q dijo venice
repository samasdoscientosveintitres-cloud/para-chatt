"""Auto-hop con máquina de estados explícita."""
from __future__ import annotations

import asyncio
import logging
import time
from enum import Enum

from config import Config
from join_handler import build, open_protocol
from models import Verification

log = logging.getLogger("sniper.hop")


class HopState(str, Enum):
    IDLE = "idle"
    SELECTING = "selecting"
    REQUESTED = "requested"
    WAITING = "waiting"
    SUCCESS = "success"
    FAILED = "failed"
    TIMEOUT = "timeout"


class HopController:
    def __init__(self, cfg: Config, aggregator, notifier, detector):
        self.cfg = cfg
        self.aggregator = aggregator
        self.notifier = notifier
        self.detector = detector
        self.state = HopState.IDLE
        self.task: asyncio.Task | None = None
        self.attempts = 0
        self.tried: set[str] = set()
        self.current: str | None = None
        self.last_reason: str | None = None

    @property
    def running(self) -> bool:
        return self.task is not None and not self.task.done()

    def status(self) -> dict:
        return {"running": self.running, "state": self.state.value, "attempts": self.attempts,
                "current": self.current, "reason": self.last_reason}

    def start(self) -> dict:
        if not self.cfg.auto_hop_enabled:
            return {"ok": False, "reason": "auto-hop desactivado en configuración"}
        if self.running:
            return {"ok": False, "reason": "ya está en marcha"}
        self.attempts = 0
        self.tried.clear()
        self.current = None
        self.last_reason = None
        self.state = HopState.SELECTING
        self.task = asyncio.create_task(self._run(), name="auto-hop")
        return {"ok": True, "state": self.state.value}

    async def stop(self, reason: str = "detenido por el usuario") -> dict:
        if not self.running:
            self.state = HopState.IDLE
            return {"ok": True, "state": self.state.value}
        self.last_reason = reason
        task = self.task
        if task:
            task.cancel()
            try:
                await task
            except asyncio.CancelledError:
                pass
        self.task = None
        self.state = HopState.IDLE
        return {"ok": True, "state": self.state.value}

    async def _run(self) -> None:
        try:
            while self.attempts < self.cfg.hop_max_attempts:
                self.state = HopState.SELECTING
                record = self._select()
                if record is None:
                    await asyncio.sleep(2.0)
                    continue

                self.attempts += 1
                self.tried.add(record.job_id)
                self.current = record.job_id
                link = build(record.job_id, record.place_id, record.occupancy.value)
                self.state = HopState.REQUESTED
                self.notifier.publish("hop", {"state": self.state.value, "attempt": self.attempts,
                                              "job_id": record.job_id, "web": link["web"],
                                              "ok": link["ok"], "reason": link["reason"]})
                if not link["ok"]:
                    self.state = HopState.FAILED
                    self.last_reason = link["reason"]
                    continue

                opened = open_protocol(link["protocol"])
                if not opened["opened"]:
                    self.state = HopState.FAILED
                    self.last_reason = opened["reason"]
                    continue

                self.state = HopState.WAITING
                self.notifier.publish("hop", {"state": self.state.value, "job_id": record.job_id})
                deadline = time.monotonic() + self.cfg.hop_cooldown_s
                while time.monotonic() < deadline:
                    await asyncio.sleep(0.5)
                    eggs = self.detector.report_for(record.job_id)
                    if eggs and max(e.value for e in eggs) >= self.cfg.min_value_decimal:
                        self.state = HopState.SUCCESS
                        return
                self.state = HopState.TIMEOUT
                self.last_reason = "sin confirmación del puente en la ventana de espera"
            self.state = HopState.FAILED
            self.last_reason = "límite de intentos alcanzado"
        finally:
            self.notifier.publish("hop_done", {"state": self.state.value,
                                               "job_id": self.current,
                                               "reason": self.last_reason})
            self.task = None

    def _select(self):
        candidates = [r for r in self.aggregator.active()
                      if r.job_id not in self.tried
                      and r.occupancy.value == "joinable"
                      and r.verification is Verification.UNKNOWN]
        candidates.sort(key=lambda r: r.score, reverse=True)
        return candidates[0] if candidates else None
