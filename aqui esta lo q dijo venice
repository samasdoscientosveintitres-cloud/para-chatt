"""Ciclo de vida de workers: start/stop idempotentes, sin tareas huérfanas."""
from __future__ import annotations

import asyncio
import logging
import time

from aggregator import Aggregator
from config import Config
from detection import Detector
from discovery import CursorPool, FetchResult, RobloxClient

log = logging.getLogger("sniper.workers")


class WorkerManager:
    def __init__(self, cfg: Config, client: RobloxClient, detector: Detector, aggregator: Aggregator):
        self.cfg = cfg
        self.client = client
        self.detector = detector
        self.aggregator = aggregator
        self.pool = CursorPool(cfg.max_pages)
        self._tasks: dict[int, asyncio.Task] = {}
        self._alive: set[int] = set()
        self._watchdog: asyncio.Task | None = None
        self._running = False
        self._counter = 0

    @property
    def alive(self) -> int:
        return len(self._alive)

    @property
    def running(self) -> bool:
        return self._running

    async def start(self) -> None:
        if self._running:
            return
        self._running = True
        self.pool = CursorPool(self.cfg.max_pages)
        for _ in range(self.cfg.workers):
            self._spawn()
        self._watchdog = asyncio.create_task(self._watch(), name="watchdog")
        log.info("workers iniciados: %d (concurrencia %d)", self.cfg.workers, self.cfg.max_concurrency)

    async def stop(self) -> None:
        if not self._running and not self._tasks:
            await self.pool.close()
            return
        self._running = False
        await self.pool.close()
        if self._watchdog:
            self._watchdog.cancel()
            try:
                await self._watchdog
            except asyncio.CancelledError:
                pass
            self._watchdog = None
        tasks = list(self._tasks.values())
        for task in tasks:
            task.cancel()
        if tasks:
            await asyncio.gather(*tasks, return_exceptions=True)
        self._tasks.clear()
        self._alive.clear()
        log.info("workers detenidos")

    def _spawn(self) -> None:
        self._counter += 1
        wid = self._counter
        self._tasks[wid] = asyncio.create_task(self._worker(wid), name=f"worker-{wid}")

    async def _watch(self) -> None:
        while self._running:
            await asyncio.sleep(4.0)
            for wid, task in list(self._tasks.items()):
                if task.done():
                    self._tasks.pop(wid, None)
                    if task.cancelled():
                        log.debug("worker %d cancelado", wid)
                    elif task.exception():
                        log.warning("worker %d murió: %r", wid, task.exception())
                    if self._running:
                        self._spawn()
            await self.aggregator.expire_sweep()

    async def _worker(self, wid: int) -> None:
        self._alive.add(wid)
        try:
            while self._running:
                if self.cfg.paused:
                    await asyncio.sleep(0.3)
                    continue
                cursor = await self.pool.next()
                if cursor is None:
                    await asyncio.sleep(0.12)
                    continue
                result: FetchResult | None = None
                started = time.monotonic()
                try:
                    result = await self.client.fetch(cursor)
                except asyncio.CancelledError:
                    raise
                except Exception as exc:
                    log.warning("worker %d error no controlado: %r", wid, exc)
                finally:
                    await self.pool.release(cursor, result)

                if result is None or not result.servers:
                    await asyncio.sleep(0.1)
                    continue

                self.aggregator.count_seen(len(result.servers))
                for info in result.servers:
                    record = self.detector.evaluate(info, (time.monotonic() - started) * 1000)
                    if record is not None:
                        await self.aggregator.ingest(record)
        finally:
            self._alive.discard(wid)
