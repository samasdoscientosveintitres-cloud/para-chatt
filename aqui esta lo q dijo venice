"""Clasificación de estados y validación de evidencia externa."""
from __future__ import annotations

import time

from config import Config
from models import Egg, Occupancy, ServerInfo, ServerRecord, ServerState, Verification

MAX_REPORTS = 500


class Detector:
    def __init__(self, cfg: Config):
        self.cfg = cfg
        self._reports: dict[str, tuple[list[Egg], float]] = {}

    # ---------- evidencia ----------
    def register_report(self, job_id: str, eggs: list[Egg]) -> bool:
        if not eggs:
            return False
        best = max(eggs, key=lambda e: e.value)
        if best.value < self.cfg.min_value_decimal:
            return False
        self._reports[job_id] = (eggs, time.time())
        self._prune()
        return True

    def report_for(self, job_id: str) -> list[Egg]:
        entry = self._reports.get(job_id)
        if entry is None:
            return []
        eggs, ts = entry
        if time.time() - ts > self.cfg.confirmed_ttl_s:
            self._reports.pop(job_id, None)
            return []
        return eggs

    def _prune(self) -> None:
        now = time.time()
        for job_id, (_, ts) in list(self._reports.items()):
            if now - ts > self.cfg.confirmed_ttl_s:
                self._reports.pop(job_id, None)
        if len(self._reports) > MAX_REPORTS:
            oldest = sorted(self._reports.items(), key=lambda kv: kv[1][1])[: len(self._reports) - MAX_REPORTS]
            for job_id, _ in oldest:
                self._reports.pop(job_id, None)

    # ---------- puntuación ----------
    def score(self, info: ServerInfo) -> float:
        free = info.free_slots
        if free is None or free <= 0:
            return 0.0
        ping = info.ping if info.ping is not None else self.cfg.max_ping
        fps = info.fps if info.fps is not None else 30.0
        return free * 12.0 + max(0.0, (self.cfg.max_ping - ping) / 10.0) + min(fps, 60.0) / 6.0

    # ---------- evaluación ----------
    def evaluate(self, info: ServerInfo, latency_ms: float) -> ServerRecord | None:
        occupancy = info.occupancy
        if occupancy is Occupancy.FULL:
            if not self.cfg.emit_discovered:
                return None
            state = ServerState.UNAVAILABLE
        elif occupancy is Occupancy.JOINABLE:
            if not self._passes(info):
                return None
            state = ServerState.CANDIDATE
        else:
            if not self.cfg.emit_discovered:
                return None
            state = ServerState.DISCOVERED

        record = ServerRecord(
            job_id=info.job_id, place_id=self.cfg.place_id, state=state,
            playing=info.playing, max_players=info.max_players,
            ping=info.ping, fps=info.fps, score=self.score(info),
            latency_ms=latency_ms, discovered_at=info.seen_at,
        )

        eggs = self.report_for(info.job_id)
        if eggs:
            best = max(eggs, key=lambda e: e.value)
            # el umbral puede haber cambiado desde que se registró el informe
            if best.value >= self.cfg.min_value_decimal:
                record.eggs = eggs
                record.value = best.value
                record.verification = Verification.CONFIRMED
                record.state = ServerState.CONFIRMED
                record.confirmed_at = time.time()
        return record

    def _passes(self, info: ServerInfo) -> bool:
        free = info.free_slots
        if free is None or free < self.cfg.min_free_slots:
            return False
        if self.cfg.require_joinable and info.occupancy is not Occupancy.JOINABLE:
            return False
        reject_missing = self.cfg.missing_metrics == "reject"
        if info.ping is None:
            if reject_missing:
                return False
        elif info.ping > self.cfg.max_ping:
            return False
        if info.fps is None:
            if reject_missing:
                return False
        elif info.fps < self.cfg.min_fps:
            return False
        return True
