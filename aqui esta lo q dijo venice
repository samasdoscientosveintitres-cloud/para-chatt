"""Parser estricto de cantidades abreviadas.

Coincidencia completa de la cadena (tras recortar). Formatos aceptados:
    10B  10.5B  1T  10000000000  10,000,000,000  10B+  500M  1.25T  $10B  x10B

Sufijos admitidos: K, M, B, T. No se admiten otros (Qa, Sx...) porque no está
demostrado que Steal An Egg los use.

Reglas de ambigüedad:
  * Coma de miles solo si encaja con \\d{1,3}(,\\d{3})+.
  * Coma única sin agrupación válida -> coma decimal (1,5B = 1.5B).
  * Punto siempre decimal. Coma y punto juntos -> la coma es de miles.
  * Un sufijo desconocido pegado invalida la cadena completa.
"""
from __future__ import annotations

import re
from decimal import Decimal, InvalidOperation

_MULT: dict[str, Decimal] = {
    "K": Decimal(10) ** 3,
    "M": Decimal(10) ** 6,
    "B": Decimal(10) ** 9,
    "T": Decimal(10) ** 12,
}

_NUMBER = r"(?:\d{1,3}(?:,\d{3})+(?:\.\d+)?|\d+(?:\.\d+)?|\.\d+)"
_PATTERN = re.compile(
    rf"^\$?\s*[xX]?\s*(?P<num>{_NUMBER})\s*(?P<suf>[KMBT])?\s*\+?\s*$",
    re.IGNORECASE,
)
_GROUPED = re.compile(r"^\d{1,3}(?:,\d{3})+(?:\.\d+)?$")

_TIER_T = Decimal(10) ** 12
_TIER_100B = Decimal(10) ** 11
_TIER_50B = Decimal(5) * Decimal(10) ** 10
_TIER_20B = Decimal(2) * Decimal(10) ** 10
_TIER_10B = Decimal(10) ** 10


def parse_value(raw: object) -> Decimal | None:
    """Devuelve Decimal o None. Nunca lanza."""
    if raw is None or isinstance(raw, bool):
        return None
    if isinstance(raw, Decimal):
        value = raw
    elif isinstance(raw, int):
        value = Decimal(raw)
    elif isinstance(raw, float):
        if raw != raw or raw in (float("inf"), float("-inf")):
            return None
        value = Decimal(repr(raw))
    elif isinstance(raw, str):
        text = raw.strip().replace("\u00a0", " ").replace("\u202f", " ")
        if not text:
            return None
        match = _PATTERN.match(text)
        if not match:
            return None
        num = match.group("num")
        if "," in num:
            num = num.replace(",", "") if _GROUPED.match(num) or num.count(",") > 1 else num.replace(",", ".")
        try:
            value = Decimal(num)
        except InvalidOperation:
            return None
        suffix = (match.group("suf") or "").upper()
        if suffix:
            value *= _MULT[suffix]
    else:
        return None

    if value.is_nan() or value.is_infinite() or value < 0:
        return None
    return value


def format_value(value: Decimal | int | None) -> str:
    parsed = value if isinstance(value, Decimal) else parse_value(value)
    if parsed is None:
        return "—"
    if parsed == 0:
        return "0"
    for suffix, mult in (("T", _MULT["T"]), ("B", _MULT["B"]), ("M", _MULT["M"]), ("K", _MULT["K"])):
        if parsed >= mult:
            text = format((parsed / mult).quantize(Decimal("0.01")), "f")
            return text.rstrip("0").rstrip(".") + suffix
    if parsed == parsed.to_integral_value():
        return f"{parsed:,}"
    return format(parsed.normalize(), "f")


def classify(value: Decimal | None) -> str:
    if value is None:
        return "unknown"
    if value >= _TIER_T:
        return "1T+"
    if value >= _TIER_100B:
        return "100B+"
    if value >= _TIER_50B:
        return "50B+"
    if value >= _TIER_20B:
        return "20B+"
    if value >= _TIER_10B:
        return "10B+"
    return "below-10B"


def meets(value: Decimal | None, threshold: Decimal) -> bool:
    if value is None or threshold is None:
        return False
    return value >= threshold
