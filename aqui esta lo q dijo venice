"""Enlaces de instancia. Generar != abrir != entrar."""
from __future__ import annotations

import os
import subprocess
import sys
from urllib.parse import quote_plus

from models import is_job_id, is_place_id

WEB = "https://www.roblox.com/games/start?placeId={place}&gameInstanceId={job}"
PROTO = "roblox://placeId={place}&gameInstanceId={job}"


def build(job_id: str, place_id: int, occupancy: str = "unknown") -> dict:
    if not is_place_id(place_id):
        return {"ok": False, "code": "bad_place", "reason": f"PlaceId inválido: {place_id!r}",
                "web": None, "protocol": None, "joinable": False}
    if not is_job_id(job_id):
        return {"ok": False, "code": "bad_job", "reason": "JobId ausente o con formato inválido",
                "web": None, "protocol": None, "joinable": False}

    place, job = quote_plus(str(place_id)), quote_plus(job_id)
    web, proto = WEB.format(place=place, job=job), PROTO.format(place=place, job=job)

    if occupancy == "full":
        return {"ok": True, "code": "full", "joinable": False,
                "reason": "Servidor lleno en la última comprobación: el enlace es válido, "
                          "pero Roblox puede reasignarte a otra instancia.",
                "web": web, "protocol": proto}
    if occupancy == "unknown":
        return {"ok": True, "code": "unknown_occupancy", "joinable": False,
                "reason": "Ocupación desconocida: no se puede garantizar el destino.",
                "web": web, "protocol": proto}
    return {"ok": True, "code": "ok", "joinable": True, "reason": None,
            "web": web, "protocol": proto}


def open_protocol(protocol: str) -> dict:
    """Lanza el deeplink. Éxito NO significa haberse unido."""
    try:
        if sys.platform.startswith("win"):
            os.startfile(protocol)                       # type: ignore[attr-defined]
        elif sys.platform == "darwin":
            subprocess.Popen(["open", protocol])
        else:
            subprocess.Popen(["xdg-open", protocol])
    except Exception as exc:
        return {"opened": False, "reason": f"el sistema no abrió roblox:// ({exc})"}
    return {"opened": True, "reason": None}
