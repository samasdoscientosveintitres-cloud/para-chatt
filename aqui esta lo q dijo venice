"""Entidades y validadores de dominio."""
from __future__ import annotations

import re
import time
import uuid
from dataclasses import dataclass, field
from decimal import Decimal
from enum import Enum

JOB_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", re.I)
MIN_PLACE_ID = 1
MAX_PLACE_ID = 10**17


def is_job_id(value: object) -> bool:
    return isinstance(value, str) and bool(JOB_RE.match(value))


def is_place_id(value: object) -> bool:
    return isinstance(value, int) and not isinstance(value, bool) and MIN_PLACE_ID <= value <= MAX_PLACE_ID


class ServerState(str, Enum):
    DISCOVERED = "discovered"
    CANDIDATE = "candidate"
    CONFIRMED = "confirmed"
    EXPIRED = "expired"
    UNAVAILABLE = "unavailable"


class Verification(str, Enum):
    UNKNOWN = "unknown"
    CONFIRMED = "confirmed"


class Occupancy(str, Enum):
    JOINABLE = "joinable"
    FULL = "full"
    UNKNOWN = "unknown"


STATE_RANK = {
    ServerState.DISCOVERED: 1,
    ServerState.CANDIDATE: 2,
    ServerState.UNAVAILABLE: 2,
    ServerState.CONFIRMED: 3,
    ServerState.EXPIRED: 0,
}


@dataclass(slots=True)
class Egg:
    name: str
    value: Decimal


@dataclass(slots=True)
class ServerInfo:
    job_id: str
    playing: int | None
    max_players: int | None
    ping: int | None
    fps: float | None
    seen_at: float = field(default_factory=time.time)

    @property
    def occupancy(self) -> Occupancy:
        if self.playing is None or self.max_players is None:
            return Occupancy.UNKNOWN
        return Occupancy.JOINABLE if self.playing < self.max_players else Occupancy.FULL

    @property
    def free_slots(self) -> int | None:
        if self.playing is None or self.max_players is None:
            return None
        return max(0, self.max_players - self.playing)


@dataclass(slots=True)
class ServerRecord:
    job_id: str
    place_id: int
    state: ServerState
    playing: int | None = None
    max_players: int | None = None
    ping: int | None = None
    fps: float | None = None
    score: float = 0.0
    verification: Verification = Verification.UNKNOWN
    eggs: list[Egg] = field(default_factory=list)
    value: Decimal | None = None
    discovered_at: float = field(default_factory=time.time)
    updated_at: float = field(default_factory=time.time)
    confirmed_at: float | None = None
    latency_ms: float | None = None
    id: str = field(default_factory=lambda: uuid.uuid4().hex[:12])

    @property
    def occupancy(self) -> Occupancy:
        if self.playing is None or self.max_players is None:
            return Occupancy.UNKNOWN
        return Occupancy.JOINABLE if self.playing < self.max_players else Occupancy.FULL

    @property
    def free_slots(self) -> int | None:
        if self.playing is None or self.max_players is None:
            return None
        return max(0, self.max_players - self.playing)

    def to_dict(self) -> dict:
        from value_parser import classify, format_value
        return {
            "id": self.id,
            "job_id": self.job_id,
            "place_id": self.place_id,
            "state": self.state.value,
            "occupancy": self.occupancy.value,
            "verification": self.verification.value,
            "playing": self.playing,
            "max_players": self.max_players,
            "free_slots": self.free_slots,
            "ping": self.ping,
            "fps": None if self.fps is None else round(self.fps, 1),
            "score": round(self.score, 2),
            "value": str(self.value) if self.value is not None else None,
            "value_label": format_value(self.value),
            "value_tier": classify(self.value),
            "eggs": [{"name": e.name, "value": str(e.value)} for e in self.eggs],
            "discovered_at": self.discovered_at,
            "updated_at": self.updated_at,
            "confirmed_at": self.confirmed_at,
            "latency_ms": None if self.latency_ms is None else round(self.latency_ms, 1),
        }
