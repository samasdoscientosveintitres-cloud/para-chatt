    await notifier.connect(slow)
    await notifier.connect(fast)
    for i in range(5):
        notifier.publish("record", {"i": i})
    await asyncio.sleep(0.1)
    assert notifier.count == 2
    assert len(fast.sent) == 5
    await notifier.shutdown()


@pytest.mark.asyncio
async def test_escritor_roto_no_rompe_el_hub():
    notifier = Notifier()
    broken, ok = BrokenWS(), FakeWS()
    await notifier.connect(broken)
    await notifier.connect(ok)
    notifier.publish("record", {"i": 1})
    await asyncio.sleep(0.1)
    assert notifier.count == 1
    await notifier.shutdown()


@pytest.mark.asyncio
