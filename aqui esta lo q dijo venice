import asyncio

import pytest

from discovery import Cursor, CursorPool, RobloxClient
from rate_limiter import AdaptiveLimiter

JOB = "999dad42-3c76-4dcf-8b6f-298afcc35370"


class FakeResponse:
    def __init__(self, status, payload=None, headers=None, raw=None):
        self.status = status
        self._payload = payload
        self.headers = headers or {}
        self._raw = raw

    async def json(self, content_type=None):
        if self._raw is not None:
            raise ValueError("json inválido")
        return self._payload

    async def __aenter__(self):
        return self

    async def __aexit__(self, *a):
        return False


class FakeSession:
    def __init__(self, responses):
        self.responses = list(responses)
        self.calls = 0

    def get(self, *a, **k):
        self.calls += 1
        item = self.responses.pop(0) if self.responses else FakeResponse(500)
        if isinstance(item, Exception):
            raise item
        return item


def make_client(cfg, responses):
    cfg.max_retries = 1
    return RobloxClient(cfg, AdaptiveLimiter(1000, 4), FakeSession(responses))


@pytest.mark.asyncio
async def test_respuesta_valida(cfg):
    payload = {"data": [{"id": JOB, "playing": 6, "maxPlayers": 7, "ping": 58, "fps": 59.9}],
               "nextPageCursor": "abc"}
    result = await make_client(cfg, [FakeResponse(200, payload)]).fetch(Cursor(1, 0))
    assert result.status == 200 and len(result.servers) == 1
    assert result.servers[0].free_slots == 1
    assert result.next_cursor == "abc"


@pytest.mark.asyncio
async def test_respuesta_vacia(cfg):
    result = await make_client(cfg, [FakeResponse(200, {"data": [], "nextPageCursor": None})]).fetch(Cursor(1, 0))
