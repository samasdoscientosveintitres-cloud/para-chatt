"""Descubrimiento con validación estricta y cursores opacos con profundidad real."""
from __future__ import annotations

import asyncio
import logging
from collections import deque
from dataclasses import dataclass

import aiohttp

from config import Config
from models import ServerInfo, is_job_id
from rate_limiter import AdaptiveLimiter

log = logging.getLogger("sniper.discovery")

UA = "StealAEggSniper/2.1 (+local)"
API = "https://games.roblox.com/v1/games/{place}/servers/Public"

PERMANENT = {400, 401, 403, 404}


@dataclass(slots=True)
class FetchResult:
    status: int
    servers: list[ServerInfo]
    next_cursor: str | None = None
    error: str | None = None
    retryable: bool = False
    discarded: int = 0


@dataclass(slots=True)
class Cursor:
    sort_order: int
    depth: int
    value: str | None = None


class CursorPool:
    def __init__(self, max_pages: int, orders: tuple[int, ...] = (1, 2)):
        self._max_pages = max(1, max_pages)
        self._orders = orders
        self._queue: deque[Cursor] = deque()
        self._inflight = 0
        self._known: set[str] = set()
        self._sweeps = 0
        self._lock = asyncio.Lock()
        self._closed = False

    @property
    def pending(self) -> int:
        return len(self._queue) + self._inflight

    @property
    def sweeps(self) -> int:
        return self._sweeps

    async def next(self) -> Cursor | None:
        async with self._lock:
            if self._closed:
                return None
            if not self._queue:
                if self._inflight > 0:
                    return None
                self._seed()
            cursor = self._queue.popleft()
            self._inflight += 1
            return cursor

    async def release(self, cursor: Cursor, result: FetchResult | None) -> None:
        async with self._lock:
            self._inflight = max(0, self._inflight - 1)
            if self._closed or result is None:
                return
            nxt = result.next_cursor
            if not nxt or not isinstance(nxt, str):
                return
            if cursor.depth + 1 >= self._max_pages:
                return
            if nxt in self._known:
                return
            self._known.add(nxt)
            self._queue.append(Cursor(cursor.sort_order, cursor.depth + 1, nxt))

    async def close(self) -> None:
        async with self._lock:
            self._closed = True
            self._queue.clear()

    def _seed(self) -> None:
        self._sweeps += 1
        self._known.clear()
        orders = self._orders if self._sweeps % 2 else tuple(reversed(self._orders))
        for order in orders:
            self._queue.append(Cursor(order, 0, None))
        log.info("barrido #%d sembrado (max_pages=%d)", self._sweeps, self._max_pages)


class RobloxClient:
    def __init__(self, cfg: Config, limiter: AdaptiveLimiter, session: aiohttp.ClientSession):
        self.cfg = cfg
        self.limiter = limiter
        self.session = session
        self.counters = {"429": 0, "http_errors": 0, "invalid_rows": 0, "requests": 0}

    async def fetch(self, cursor: Cursor) -> FetchResult:
        params = {"limit": self.cfg.page_limit, "sortOrder": cursor.sort_order,
                  "excludeFullGames": "true"}
        if cursor.value:
            params["cursor"] = cursor.value
        url = API.format(place=self.cfg.place_id)

        for attempt in range(self.cfg.max_retries + 1):
            await self.limiter.acquire()
            try:
                self.counters["requests"] += 1
                async with self.session.get(
                    url, params=params,
                    headers={"User-Agent": UA, "Accept": "application/json"},
                    timeout=aiohttp.ClientTimeout(total=self.cfg.request_timeout_s),
                ) as resp:
                    status = resp.status
                    if status == 429:
                        self.counters["429"] += 1
                        raw = resp.headers.get("Retry-After", "")
                        retry_after = float(raw) if raw.replace(".", "", 1).isdigit() else None
                        self.limiter.note_rate_limited(retry_after)
                        if attempt >= self.cfg.max_retries:
                            return FetchResult(status, [], retryable=True, error="429")
                        continue
                    if status in PERMANENT:
                        self.counters["http_errors"] += 1
                        self.limiter.note_success()
                        return FetchResult(status, [], error=f"HTTP {status}")
                    if status >= 500:
                        self.counters["http_errors"] += 1
                        self.limiter.note_retryable(attempt)
                        if attempt >= self.cfg.max_retries:
                            return FetchResult(status, [], retryable=True, error=f"HTTP {status}")
                        continue
                    if status != 200:
                        self.counters["http_errors"] += 1
                        return FetchResult(status, [], error=f"HTTP {status}")
                    try:
                        payload = await resp.json(content_type=None)
                    except Exception:
                        self.counters["http_errors"] += 1
                        self.limiter.note_retryable(attempt)
                        if attempt >= self.cfg.max_retries:
                            return FetchResult(status, [], retryable=True, error="JSON inválido")
                        continue
                    self.limiter.note_success()
                    return self._parse(payload, status)
            except asyncio.CancelledError:
                raise
            except (asyncio.TimeoutError, aiohttp.ClientError) as exc:
                self.counters["http_errors"] += 1
                self.limiter.note_retryable(attempt)
                log.debug("red (%s) intento %d/%d", type(exc).__name__, attempt + 1, self.cfg.max_retries + 1)
                if attempt >= self.cfg.max_retries:
                    return FetchResult(0, [], retryable=True, error=type(exc).__name__)
            finally:
                await self.limiter.release()
        return FetchResult(0, [], retryable=True, error="reintentos agotados")

    def _parse(self, payload: object, status: int) -> FetchResult:
        if not isinstance(payload, dict):
            return FetchResult(status, [], error="payload no es objeto")
        rows = payload.get("data")
        if not isinstance(rows, list):
            return FetchResult(status, [], error="'data' no es lista")
        nxt = payload.get("nextPageCursor")
        if nxt is not None and not isinstance(nxt, str):
            nxt = None

        servers: list[ServerInfo] = []
        discarded = 0
        for row in rows:
            if not isinstance(row, dict) or not is_job_id(row.get("id")):
                discarded += 1
                continue
            servers.append(ServerInfo(
                job_id=row["id"],
                playing=_int_or_none(row.get("playing")),
                max_players=_int_or_none(row.get("maxPlayers")),
                ping=_int_or_none(row.get("ping")),
                fps=_float_or_none(row.get("fps")),
            ))
        self.counters["invalid_rows"] += discarded
        return FetchResult(status, servers, nxt, discarded=discarded)


def _int_or_none(value: object) -> int | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if value != value or value < 0:
        return None
    return int(value)


def _float_or_none(value: object) -> float | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if value != value or value <= 0:
        return None
    return float(value)
