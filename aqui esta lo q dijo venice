import asyncio

import pytest

from notifier import Notifier


class FakeWS:
    def __init__(self):
        self.sent = []
        self.accepted = False

    async def accept(self):
        self.accepted = True

    async def send_text(self, text):
        self.sent.append(text)


class SlowWS(FakeWS):
    async def send_text(self, text):
        await asyncio.sleep(5)
        self.sent.append(text)


class BrokenWS(FakeWS):
    async def send_text(self, text):
        raise RuntimeError("socket roto")


@pytest.mark.asyncio
async def test_broadcast():
    notifier = Notifier()
    ws = FakeWS()
    await notifier.connect(ws)
    notifier.publish("record", {"job_id": "x"})
    await asyncio.sleep(0.05)
    assert ws.accepted and len(ws.sent) == 1
    await notifier.shutdown()


@pytest.mark.asyncio
async def test_hello_dirigido():
    notifier = Notifier()
    first, second = FakeWS(), FakeWS()
    await notifier.connect(first)
    await notifier.connect(second)
    await notifier.send_hello(second, {"paused": False})
    await asyncio.sleep(0.05)
    assert first.sent == [] and len(second.sent) == 1
    await notifier.shutdown()


@pytest.mark.asyncio
async def test_desconexion_limpia():
