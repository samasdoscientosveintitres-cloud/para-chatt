"""Configuración persistente, validada, atómica y con soporte de entorno."""
from __future__ import annotations

import json
import logging
import os
import secrets
import tempfile
import threading
from dataclasses import dataclass, field
from decimal import Decimal
from pathlib import Path

from value_parser import parse_value

BASE_DIR = Path(__file__).resolve().parent
CONFIG_PATH = BASE_DIR / "config.json"

DEFAULT_PLACE_ID = 107778070777162

ENV_PREFIX = "SNIPER_"
MAX_REPAIRS = 32

log = logging.getLogger("sniper.config")


class ConfigError(ValueError):
    def __init__(self, field_name: str, message: str):
        super().__init__(f"{field_name}: {message}")
        self.field_name = field_name
        self.message = message


PERSISTENT_FIELDS: tuple[str, ...] = (
    "place_id", "min_value", "workers", "max_concurrency", "requests_per_second",
    "page_limit", "max_pages", "request_timeout_s", "max_retries",
    "max_ping", "min_fps", "min_free_slots", "require_joinable",
    "missing_metrics", "emit_discovered", "record_ttl_s", "confirmed_ttl_s",
    "history_limit", "bridge_enabled", "bridge_rate_per_min",
    "auto_hop_enabled", "hop_cooldown_s", "hop_max_attempts",
    "notify_sound", "paused", "enable_discovery",
)

SECRET_FIELDS: tuple[str, ...] = ("bridge_token",)
BOOL_FIELDS = (
    "require_joinable", "emit_discovered", "bridge_enabled",
    "auto_hop_enabled", "notify_sound", "paused", "enable_discovery",
)

# nombre -> (tipo, mínimo, máximo)
LIMITS: dict[str, tuple[str, float, float]] = {
    "workers": ("int", 1, 100),
    "max_concurrency": ("int", 1, 64),
    "requests_per_second": ("float", 0.5, 40.0),
    "max_pages": ("int", 1, 50),
    "max_retries": ("int", 0, 6),
    "max_ping": ("int", 20, 2000),
    "min_fps": ("float", 0.0, 240.0),
    "min_free_slots": ("int", 1, 50),
    "record_ttl_s": ("int", 20, 3600),
    "confirmed_ttl_s": ("int", 30, 7200),
    "history_limit": ("int", 10, 2000),
    "bridge_rate_per_min": ("int", 1, 600),
    "hop_cooldown_s": ("float", 2.0, 120.0),
    "hop_max_attempts": ("int", 1, 500),
    "request_timeout_s": ("float", 2.0, 60.0),
}

_TRUTHY = {"1", "true", "yes", "on", "si", "sí"}


def _as_bool(raw: object) -> bool:
    if isinstance(raw, bool):
        return raw
    return str(raw).strip().lower() in _TRUTHY


@dataclass
class Config:
    place_id: int = DEFAULT_PLACE_ID
    min_value: str = "10B"

    workers: int = 12
    max_concurrency: int = 8
    requests_per_second: float = 4.0
    page_limit: int = 100
    max_pages: int = 7
    request_timeout_s: float = 12.0
    max_retries: int = 3

    max_ping: int = 250
    min_fps: float = 45.0
    min_free_slots: int = 1
    require_joinable: bool = True
    missing_metrics: str = "allow"
    emit_discovered: bool = False

    record_ttl_s: int = 90
    confirmed_ttl_s: int = 300
    history_limit: int = 300

    bridge_enabled: bool = True
    bridge_rate_per_min: int = 30
    bridge_token: str = ""

    auto_hop_enabled: bool = True
    hop_cooldown_s: float = 12.0
    hop_max_attempts: int = 40

    notify_sound: bool = True
    paused: bool = False
    enable_discovery: bool = True

    _lock: threading.Lock = field(default_factory=threading.Lock, repr=False, compare=False)

    @property
    def min_value_decimal(self) -> Decimal:
        parsed = parse_value(self.min_value)
        return parsed if parsed is not None else Decimal(10) ** 10

    # ---------- serialización ----------
    def to_dict(self) -> dict:
        return {name: getattr(self, name) for name in PERSISTENT_FIELDS}

    def secrets_dict(self) -> dict:
        return {name: getattr(self, name) for name in SECRET_FIELDS}

    def public_dict(self) -> dict:
        data = self.to_dict()
        data["min_value_decimal"] = str(self.min_value_decimal)
        data["has_bridge_token"] = bool(self.bridge_token)
        return data

    # ---------- validación ----------
    def _coerce_number(self, name: str, raw: object) -> int | float:
        kind, low, high = LIMITS[name]
        try:
            value = int(raw) if kind == "int" else float(raw)
        except (TypeError, ValueError):
            raise ConfigError(name, f"tipo inválido: {raw!r}")
        if kind == "float" and (value != value or value in (float("inf"), float("-inf"))):
            raise ConfigError(name, "NaN o infinito")
        if not low <= value <= high:
            raise ConfigError(name, f"fuera de rango [{low}, {high}]: {value}")
        return value

    def validate(self) -> None:
        if not isinstance(self.place_id, int) or isinstance(self.place_id, bool) or self.place_id < 1:
            raise ConfigError("place_id", f"PlaceId inválido: {self.place_id!r}")
        if parse_value(self.min_value) is None:
            raise ConfigError("min_value", f"no interpretable: {self.min_value!r}")
        for name in LIMITS:
            setattr(self, name, self._coerce_number(name, getattr(self, name)))
        if self.page_limit not in (10, 25, 50, 100):
            raise ConfigError("page_limit", "solo 10, 25, 50 o 100")
        if self.missing_metrics not in ("allow", "reject"):
            raise ConfigError("missing_metrics", "debe ser 'allow' o 'reject'")
        for name in BOOL_FIELDS:
            setattr(self, name, _as_bool(getattr(self, name)))
        if self.max_concurrency > self.workers:
            self.max_concurrency = self.workers
        if self.confirmed_ttl_s < self.record_ttl_s:
            self.confirmed_ttl_s = self.record_ttl_s
        if not self.bridge_token:
            self.bridge_token = secrets.token_urlsafe(24)

    def repair(self, exc: ConfigError) -> None:
        default = Config()
        if hasattr(default, exc.field_name):
            setattr(self, exc.field_name, getattr(default, exc.field_name))

    # ---------- entorno ----------
    def apply_env(self, environ: dict | None = None) -> None:
        source = environ if environ is not None else os.environ
        for name in PERSISTENT_FIELDS + SECRET_FIELDS:
            raw = source.get(ENV_PREFIX + name.upper())
            if raw is None:
                continue
            if name in BOOL_FIELDS:
                setattr(self, name, _as_bool(raw))
            elif name in LIMITS:
                setattr(self, name, LIMITS[name][0] and raw)
            else:
                setattr(self, name, raw)

    # ---------- persistencia ----------
    def save(self, path: Path | None = None) -> None:
        target = Path(path or CONFIG_PATH)
        payload = json.dumps({**self.to_dict(), **self.secrets_dict()}, indent=2, ensure_ascii=False)
        with self._lock:
            fd, tmp_name = tempfile.mkstemp(dir=str(target.parent), prefix=".config-", suffix=".tmp")
            try:
                with os.fdopen(fd, "w", encoding="utf-8") as fh:
                    fh.write(payload)
                    fh.flush()
                    os.fsync(fh.fileno())
                os.replace(tmp_name, target)
                try:
                    os.chmod(target, 0o600)
                except OSError:
                    pass
            except Exception:
                if os.path.exists(tmp_name):
                    try:
                        os.unlink(tmp_name)
                    except OSError:
                        pass
                raise

    @classmethod
    def load(cls, path: Path | None = None, environ: dict | None = None) -> "Config":
        source = Path(path or CONFIG_PATH)
        cfg = cls()
        if source.exists():
            try:
                raw = json.loads(source.read_text(encoding="utf-8"))
                if not isinstance(raw, dict):
                    raise ValueError("la raíz no es un objeto")
                for key, value in raw.items():
                    if key in PERSISTENT_FIELDS or key in SECRET_FIELDS:
                        setattr(cfg, key, value)
            except Exception as exc:
                backup = source.with_suffix(".json.bak")
                try:
                    os.replace(source, backup)
                except OSError:
                    pass
                log.warning("configuración ilegible (%s); respaldo en %s", exc, backup.name)
        cfg.apply_env(environ)
        for _ in range(MAX_REPAIRS):
            try:
                cfg.validate()
                break
            except ConfigError as exc:
                log.warning("valor inválido (%s); se restaura el predeterminado", exc)
                cfg.repair(exc)
        return cfg


def validate_port(port: int) -> int:
    if not isinstance(port, int) or not 1 <= port <= 65535:
        raise ConfigError("port", f"puerto fuera de rango: {port!r}")
    return port


def setup_logging(level: int = logging.INFO) -> None:
    logging.basicConfig(
        level=level,
        format="%(asctime)s | %(levelname)-7s | %(name)-22s | %(message)s",
        datefmt="%H:%M:%S",
    )
    logging.getLogger("aiohttp").setLevel(logging.WARNING)
