--[[ SniperBridge (opcional)
     Reporta al sniper los huevos visibles en la instancia actual.
     Sin acceso a memoria: recorre instancias públicas de workspace y sus BillboardGui.
     Requiere un ejecutor con capacidad HTTP. Si no la hay, avisa y termina.
     TOKEN se obtiene de http://127.0.0.1:8710/api/bridge/info
]]

local URL = "http://127.0.0.1:8710/api/bridge/report"
local TOKEN = "PEGA_AQUI_EL_TOKEN"
local INTERVALO = 2.5
local MIN_VALOR = 1e8
local MAX_ENVIOS = 40
local SUFIJOS = { K = 1e3, M = 1e6, B = 1e9, T = 1e12 }

local HttpService = game:GetService("HttpService")
local JOB = game.JobId
local PLACE = tonumber(game.PlaceId)

local function resolverHttp()
    if typeof(syn) == "table" and syn.request then return syn.request end
    if typeof(http_request) == "function" then return http_request end
    if typeof(request) == "function" then return request end
    return nil
end

local enviar = resolverHttp()
if not enviar then
    warn("[SniperBridge] el ejecutor no expone request/http_request/syn.request; sin puente")
    return
end
if JOB == nil or JOB == "" then
    warn("[SniperBridge] sin JobId (servidor local o Studio)")
    return
end

local function parsear(texto)
    local limpio = tostring(texto):upper():gsub("[%$%+,%s]", "")
    local numero, sufijo = limpio:match("^(%d+%.?%d*)([KMBT]?)$")
    if not numero then return nil end
    local valor = tonumber(numero)
    if not valor then return nil end
    if sufijo ~= "" then valor = valor * (SUFIJOS[sufijo] or 1) end
    return valor
end

local function escanear()
    local salida, vistos = {}, {}
    local total = 0
    for _, objeto in ipairs(workspace:GetDescendants()) do
        if total >= MAX_ENVIOS then break end
        if objeto:IsA("BillboardGui") and objeto.Enabled then
            for _, hijo in ipairs(objeto:GetDescendants()) do
                if hijo:IsA("TextLabel") then
                    local valor = parsear(hijo.Text)
                    if valor and valor >= MIN_VALOR then
                        local dueno = objeto.Parent
                        local nombre = (dueno and dueno.Name or "Egg"):sub(1, 48)
                        local clave = nombre .. "|" .. tostring(math.floor(valor))
                        if not vistos[clave] then
                            vistos[clave] = true
                            salida[#salida + 1] = { name = nombre, value = tostring(math.floor(valor)) }
                        end
                    end
                end
            end
        end
        total = total + 1
    end
    return salida
end

local ultimo = ""
local fallos = 0

task.spawn(function()
    while true do
        local huevos = escanear()
        if #huevos > 0 then
            local firma = HttpService:JSONEncode(huevos)
            if firma ~= ultimo then
                local ok, respuesta = pcall(function()
                    return enviar({
                        Url = URL, Method = "POST",
                        Body = HttpService:JSONEncode({ job_id = JOB, place_id = PLACE, eggs = huevos }),
                        Headers = { ["Content-Type"] = "application/json", ["X-Bridge-Token"] = TOKEN },
                    })
                end)
                if ok and respuesta then
                    ultimo = firma
                    fallos = 0
                else
                    fallos = fallos + 1
                    if fallos == 3 then
                        warn("[SniperBridge] 3 fallos seguidos; ¿sniper apagado o token incorrecto?")
                    end
                end
            end
        end
        task.wait(INTERVALO)
    end
end)

print("[SniperBridge] activo en " .. JOB)
