"""Difusión con cola acotada por cliente. Descarte del mensaje más antiguo."""
from __future__ import annotations

import asyncio
import json
import logging
import time

from fastapi import WebSocket

log = logging.getLogger("sniper.notifier")

QUEUE_SIZE = 64


class Client:
    __slots__ = ("ws", "queue", "task", "dropped")

    def __init__(self, ws: WebSocket):
        self.ws = ws
        self.queue: asyncio.Queue[str] = asyncio.Queue(maxsize=QUEUE_SIZE)
        self.task: asyncio.Task | None = None
        self.dropped = 0


class Notifier:
    def __init__(self) -> None:
        self._clients: dict[WebSocket, Client] = {}

    @property
    def count(self) -> int:
        return len(self._clients)

    def _enqueue(self, client: Client, payload: str) -> None:
        try:
            client.queue.put_nowait(payload)
        except asyncio.QueueFull:
            try:
                client.queue.get_nowait()
                client.queue.put_nowait(payload)
                client.dropped += 1
            except (asyncio.QueueEmpty, asyncio.QueueFull):
                pass

    async def connect(self, ws: WebSocket) -> Client:
        await ws.accept()
        client = Client(ws)
        self._clients[ws] = client
        client.task = asyncio.create_task(self._writer(client), name="ws-writer")
        return client

    async def send_hello(self, ws: WebSocket, data: dict) -> None:
        client = self._clients.get(ws)
        if client:
            self._enqueue(client, _payload("hello", data))

    async def disconnect(self, ws: WebSocket) -> None:
        client = self._clients.pop(ws, None)
        if client and client.task and client.task is not asyncio.current_task():
            client.task.cancel()
            try:
                await client.task
            except (asyncio.CancelledError, Exception):
                pass

    async def _writer(self, client: Client) -> None:
        try:
            while True:
                message = await client.queue.get()
                await client.ws.send_text(message)
        except asyncio.CancelledError:
            raise
        except Exception as exc:
            log.debug("escritor WS caído: %r", exc)
            await self.disconnect(client.ws)

    def publish(self, event: str, data: dict) -> None:
        if not self._clients:
            return
        payload = _payload(event, data)
        for client in list(self._clients.values()):
            self._enqueue(client, payload)

    async def shutdown(self) -> None:
        for ws in list(self._clients):
            await self.disconnect(ws)


def _payload(event: str, data: dict) -> str:
    return json.dumps({"event": event, "ts": time.time(), "data": data}, default=str)
