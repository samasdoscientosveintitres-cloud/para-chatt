'use strict';

const $ = (id) => document.getElementById(id);
const WS_PROTO = location.protocol === 'https:' ? 'wss://' : 'ws://';
const TOKEN_KEY = 'sniper-token';
const feed = $('feed');

const STAT_DEFS = [
  ['candidates', 'CANDIDATOS'],
  ['unknown_verification', 'SIN VERIFICAR'],
  ['confirmed', 'CONFIRMADOS'],
  ['servers_seen', 'FILAS VISTAS'],
  ['servers_evaluated', 'EVALUADOS'],
  ['rate_limited', 'LIMITADOS'],
  ['http_errors', 'ERRORES'],
];

let formDirty = false;
let soundOn = true;
let authRequired = false;
let lastBeep = { id: null, at: 0 };
let audioCtx = null;
let ws = null;
let reconnectTimer = null;
const rendered = new Map();

function token() {
  return localStorage.getItem(TOKEN_KEY) || '';
}

function log(message) {
  const el = $('log');
  el.textContent = `[${new Date().toLocaleTimeString()}] ${message}\n` + el.textContent;
  if (el.textContent.length > 6000) el.textContent = el.textContent.slice(0, 6000);
}

async function api(path, options) {
  const opts = Object.assign({}, options || {});
  const headers = Object.assign({}, opts.headers || {});
  const current = token();
  if (current) headers['X-Local-Token'] = current;
  opts.headers = headers;
  const res = await fetch(path, opts);
  const text = await res.text();
  let body = null;
  try { body = text ? JSON.parse(text) : null; } catch { body = null; }
  if (!res.ok) {
    const message = (body && body.error && body.error.message) || `HTTP ${res.status}`;
    if (res.status === 401) $('auth-msg').textContent = 'token requerido o incorrecto';
    throw new Error(message);
  }
  return body;
}

function fmt(value) {
  if (value === null || value === undefined) return null;
  const n = Number(value);
  if (!Number.isFinite(n)) return null;
  if (n >= 1e12) return (n / 1e12).toFixed(2).replace(/\.?0+$/, '') + 'T';
  if (n >= 1e9) return (n / 1e9).toFixed(2).replace(/\.?0+$/, '') + 'B';
  if (n >= 1e6) return (n / 1e6).toFixed(2).replace(/\.?0+$/, '') + 'M';
  return n.toLocaleString();
}

function beep(freq) {
  if (!soundOn) return;
  try {
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return;
    audioCtx = audioCtx || new AC();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.frequency.value = freq;
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    gain.gain.setValueAtTime(0.06, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.25);
    osc.start();
    osc.stop(audioCtx.currentTime + 0.25);
  } catch { /* audio opcional */ }
}

function badge(text, cls) {
  const span = document.createElement('span');
  span.className = 'badge ' + cls;
  span.textContent = text;
  return span;
}

function buildCard(record) {
  const confirmed = record.verification === 'confirmed';
  const card = document.createElement('article');
  card.className = 'f'
    + (confirmed ? ' confirmed' : '')
    + (confirmed && Number(record.value) >= 1e10 ? ' hot' : '')
    + (record.state === 'unavailable' ? ' unavail' : '');
  card.tabIndex = 0;

  const row = document.createElement('div');
  row.className = 'row';
  const value = document.createElement('span');
  const label = fmt(record.value);
  value.className = 'val' + (label ? '' : ' unknown');
  value.textContent = label || 'sin datos';
  row.appendChild(value);
  row.appendChild(badge(confirmed ? 'CONFIRMADO' : 'CANDIDATO', confirmed ? 'ok' : 'warn'));
  card.appendChild(row);

  if (record.state === 'unavailable') card.appendChild(badge('LLENO', 'bad'));

  const job = document.createElement('div');
  job.className = 'job';
  job.textContent = record.job_id;
  card.appendChild(job);

  const meta = document.createElement('div');
  meta.className = 'meta';
  const parts = [
    ['PLAYERS', `${record.playing ?? '?'}/${record.max_players ?? '?'}`],
    ['PING', record.ping ?? '?'],
    ['FREE', record.free_slots ?? '?'],
  ];
  for (const [key, val] of parts) {
    const span = document.createElement('span');
    span.textContent = key + ' ';
    const strong = document.createElement('b');
    strong.textContent = String(val);
    span.appendChild(strong);
    meta.appendChild(span);
  }
  card.appendChild(meta);

  card.addEventListener('click', () => openModal(record));
  card.addEventListener('keydown', (ev) => { if (ev.key === 'Enter') openModal(record); });
  return card;
}

function upsert(record) {
  if (!record || !record.job_id) return;
  const existing = rendered.get(record.job_id);
  const card = buildCard(record);
  rendered.set(record.job_id, { card, record });
  if (existing && existing.card.parentNode) {
    existing.card.replaceWith(card);
  } else {
    const empty = feed.querySelector('.empty');
    if (empty) empty.remove();
    feed.prepend(card);
  }
  while (feed.children.length > 200) feed.lastChild.remove();

  if (record.verification === 'confirmed') {
    const now = Date.now();
    if (lastBeep.id !== record.id && now - lastBeep.at > 900) {
      lastBeep = { id: record.id, at: now };
      beep(Number(record.value) >= 1e10 ? 880 : 620);
    }
  }
}

function removeCard(jobId) {
  const entry = rendered.get(jobId);
  if (!entry) return;
  entry.card.remove();
  rendered.delete(jobId);
}

function renderEmpty(text) {
  feed.replaceChildren();
  const div = document.createElement('p');
  div.className = 'empty';
  div.textContent = text;
  feed.appendChild(div);
}

function renderMini(holderId, rows) {
  const holder = $(holderId);
  holder.replaceChildren();
  for (const [label, value] of rows) {
    const div = document.createElement('div');
    const span = document.createElement('span');
    span.textContent = label;
    const b = document.createElement('b');
    b.textContent = value;
    div.append(span, b);
    holder.appendChild(div);
  }
}

function renderStats(state) {
  const holder = $('stats');
  holder.replaceChildren();
  const rows = STAT_DEFS.map(([key, title]) => [title, String(state.stats[key] ?? 0)]);
  for (const [title, value] of rows) {
    const wrap = document.createElement('div');
    const lab = document.createElement('label');
    lab.textContent = title;
    const span = document.createElement('span');
    span.textContent = value;
    wrap.append(lab, span);
    holder.appendChild(wrap);
  }
  renderMini('mini', [
    ...rows,
    ['RPS REAL', String(state.rps_measured)],
    ['RPS OBJETIVO', String(state.rps_target)],
  ]);
  renderMini('bridge-mini', [
    ['Estado', state.bridge.enabled ? 'ACTIVO' : 'INACTIVO'],
    ['Token', state.bridge.has_token ? 'definido' : 'ausente'],
    ['Bloqueo 429', `${state.blocked_for}s`],
  ]);
  authRequired = Boolean(state.auth_required);
  $('auth-msg').textContent = authRequired && !token() ? 'servicio expuesto: introduce el token' : '';
}

function fillForm(config) {
  if (formDirty) return;
  $('cfg-min').value = config.min_value;
  $('cfg-workers').value = config.workers;
  $('cfg-conc').value = config.max_concurrency;
  $('cfg-rps').value = config.requests_per_second;
  $('cfg-ping').value = config.max_ping;
  $('cfg-missing').value = config.missing_metrics;
  $('cfg-discovered').checked = config.emit_discovered;
}

async function refresh() {
  try {
    const state = await api('/api/state');
    soundOn = state.config.notify_sound;
    $('dot').className = 'dot' + (state.paused ? '' : ' live');
    $('btn-pause').textContent = state.paused ? 'REANUDAR' : 'PAUSAR';
    $('btn-hop').textContent = state.hop.running ? 'DETENER HOP' : 'AUTO-HOP';
    $('btn-sound').textContent = 'SONIDO: ' + (soundOn ? 'ON' : 'OFF');
    renderStats(state);
    fillForm(state.config);
    const present = new Set();
    for (const record of state.findings) {
      present.add(record.job_id);
      upsert(record);
    }
    for (const jobId of [...rendered.keys()]) {
      if (!present.has(jobId)) removeCard(jobId);
    }
    if (rendered.size === 0) {
      renderEmpty(state.paused ? 'Sniper en pausa.' : 'Sin resultados todavía.');
    }
  } catch (err) {
    $('dot').className = 'dot';
    log('error de estado: ' + err.message);
  }
}

async function openModal(record) {
  $('m-egg').textContent = record.eggs.length ? record.eggs.map((e) => e.name).join(', ') : 'no identificado';
  $('m-val').textContent = record.value ? (fmt(record.value) || '—') : 'desconocido (sin verificar)';
  $('m-sid').textContent = record.job_id;
  $('m-time').textContent = new Date(record.discovered_at * 1000).toLocaleString();
  $('m-ver').textContent = record.verification === 'confirmed' ? 'CONFIRMADO' : 'NO VERIFICADO';
  $('m-slots').textContent = record.free_slots === null
    ? 'desconocido' : `${record.free_slots} libres de ${record.max_players}`;
  $('m-acc').textContent = record.occupancy === 'joinable' ? 'accesible'
    : record.occupancy === 'full' ? 'lleno' : 'desconocido';
  $('m-note').textContent = '';
  $('modal-kind').textContent = record.verification === 'confirmed'
    ? 'Huevo confirmado por fuente externa' : 'Candidato: instancia sin datos de contenido';
  $('modal').classList.remove('hidden');

  const joinBtn = $('m-join');
  const webBtn = $('m-web');
  joinBtn.disabled = true;
  webBtn.disabled = true;
  joinBtn.textContent = '[JOIN]';
  joinBtn.onclick = null;
  webBtn.onclick = null;

  try {
    const link = await api('/api/join/' + encodeURIComponent(record.job_id));
    webBtn.disabled = !link.web;
    if (link.web) webBtn.onclick = () => window.open(link.web, '_blank', 'noopener');
    joinBtn.disabled = !link.protocol;
    joinBtn.textContent = record.verification === 'confirmed'
      ? `[${record.value_tier} | JOIN]` : '[JOIN]';
    if (link.reason) $('m-note').textContent = link.reason;
    joinBtn.onclick = async () => {
      joinBtn.disabled = true;
      try {
        const result = await api('/api/join/' + encodeURIComponent(record.job_id) + '?launch=true');
        $('m-note').textContent = result.open_result && result.open_result.opened
          ? 'Deeplink lanzado. Abrir Roblox no garantiza entrar a esta instancia.'
          : ((result.open_result && result.open_result.reason) || 'no se pudo lanzar el enlace');
      } catch (err) {
        $('m-note').textContent = err.message;
      } finally {
        joinBtn.disabled = !link.protocol;
      }
    };
  } catch (err) {
    $('m-note').textContent = err.message;
  }

  $('m-copy').onclick = async () => {
    try {
      await navigator.clipboard.writeText(record.job_id);
      $('m-note').textContent = 'JobId copiado.';
    } catch {
      $('m-note').textContent = 'el navegador no permitió copiar.';
    }
  };
}

$('m-close').onclick = () => $('modal').classList.add('hidden');
$('modal').addEventListener('click', (ev) => { if (ev.target.id === 'modal') $('modal').classList.add('hidden'); });
document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') $('modal').classList.add('hidden'); });

for (const id of ['cfg-min', 'cfg-workers', 'cfg-conc', 'cfg-rps', 'cfg-ping', 'cfg-missing', 'cfg-discovered']) {
  $(id).addEventListener('input', () => { formDirty = true; });
  $(id).addEventListener('change', () => { formDirty = true; });
}

$('cfg-token').value = token();
$('cfg-token').addEventListener('input', () => {
  const value = $('cfg-token').value.trim();
  if (value) localStorage.setItem(TOKEN_KEY, value);
  else localStorage.removeItem(TOKEN_KEY);
});

