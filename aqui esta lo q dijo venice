"""Limitador global: gate de concurrencia mutable + token bucket + bloqueo por 429."""
from __future__ import annotations

import asyncio
import logging
import random
import time
from collections import deque

log = logging.getLogger("sniper.limiter")


class _Gate:
    """Contador de concurrencia con límite modificable en caliente."""

    def __init__(self, limit: int):
        self._limit = max(1, int(limit))
        self._active = 0
        self._cond = asyncio.Condition()

    @property
    def active(self) -> int:
        return self._active

    async def enter(self) -> None:
        async with self._cond:
            while self._active >= self._limit:
                await self._cond.wait()
            self._active += 1

    async def leave(self) -> None:
        async with self._cond:
            if self._active > 0:
                self._active -= 1
            self._cond.notify()

    async def set_limit(self, limit: int) -> None:
        async with self._cond:
            self._limit = max(1, int(limit))
            self._cond.notify_all()


class AdaptiveLimiter:
    def __init__(self, rps: float, max_concurrency: int):
        self._base_rate = max(0.5, float(rps))
        self._rate = self._base_rate
        self._gate = _Gate(max_concurrency)
        self._tokens = self._base_rate
        self._last = time.monotonic()
        self._blocked_until = 0.0
        self._errors = 0
        self._completions: deque[float] = deque(maxlen=400)
        self._lock = asyncio.Lock()

    @property
    def target_rps(self) -> float:
        return round(self._rate, 2)

    @property
    def measured_rps(self) -> float:
        now = time.monotonic()
        recent = [t for t in self._completions if now - t <= 10.0]
        return round(len(recent) / 10.0, 2)

    @property
    def blocked_for(self) -> float:
        return round(max(0.0, self._blocked_until - time.monotonic()), 2)

    @property
    def concurrency(self) -> int:
        return self._gate._limit

    async def acquire(self) -> None:
        await self._gate.enter()
        try:
            await self._wait_turn()
        except asyncio.CancelledError:
            await self._gate.leave()
            raise

    async def release(self) -> None:
        self._completions.append(time.monotonic())
        await self._gate.leave()

    async def _wait_turn(self) -> None:
        while True:
            now = time.monotonic()
            if now < self._blocked_until:
                await asyncio.sleep(min(self._blocked_until - now, 2.0))
                continue
            async with self._lock:
                now = time.monotonic()
                self._tokens = min(self._base_rate, self._tokens + (now - self._last) * self._rate)
                self._last = now
                if self._tokens >= 1.0:
                    self._tokens -= 1.0
                    return
                wait = (1.0 - self._tokens) / max(self._rate, 0.01)
            await asyncio.sleep(min(wait, 1.0))

    def note_success(self) -> None:
        self._errors = 0
        if self._rate < self._base_rate:
            self._rate = min(self._base_rate, self._rate + 0.05)

    def note_rate_limited(self, retry_after: float | None = None) -> None:
        self._rate = max(0.5, self._rate * 0.5)
        self._tokens = 0.0
        delay = retry_after if retry_after and retry_after > 0 else min(2 ** self._errors, 20) + random.uniform(0, 0.6)
        self._blocked_until = max(self._blocked_until, time.monotonic() + min(delay, 30.0))
        self._errors = min(self._errors + 1, 6)
        log.warning("429: bloqueo global %.1fs, objetivo %.2f rps", self.blocked_for, self._rate)

    def note_retryable(self, attempt: int) -> None:
        delay = min(0.6 * (2 ** attempt), 8.0) + random.uniform(0, 0.4)
        self._blocked_until = max(self._blocked_until, time.monotonic() + delay)
        self._errors = min(self._errors + 1, 6)

    async def retune(self, rps: float, max_concurrency: int) -> None:
        self._base_rate = max(0.5, float(rps))
        self._rate = min(self._rate, self._base_rate)
        await self._gate.set_limit(max_concurrency)
