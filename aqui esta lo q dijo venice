"""Aplicación FastAPI. create_app recibe la configuración ya validada."""
from __future__ import annotations

import logging
from contextlib import asynccontextmanager
from pathlib import Path
from urllib.parse import urlparse

import aiohttp
from fastapi import Depends, FastAPI, Header, HTTPException, Request, WebSocket, WebSocketDisconnect
from fastapi.responses import FileResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel, field_validator

import bridge
import join_handler
from aggregator import Aggregator
from config import Config, ConfigError
from detection import Detector
from discovery import RobloxClient
from hop_controller import HopController
from models import is_job_id
from notifier import Notifier
from rate_limiter import AdaptiveLimiter
from value_parser import parse_value
from worker_manager import WorkerManager

log = logging.getLogger("sniper.server")
UI_DIR = Path(__file__).parent / "ui"
LOOPBACK = {"127.0.0.1", "localhost", "::1", "[::1]"}


class ApiError(Exception):
    def __init__(self, status: int, code: str, message: str):
        self.status, self.code, self.message = status, code, message


class Ctx:
    def __init__(self, cfg: Config):
        self.cfg = cfg
        self.limiter = AdaptiveLimiter(cfg.requests_per_second, cfg.max_concurrency)
        self.notifier = Notifier()
        self.detector = Detector(cfg)
        self.aggregator = Aggregator(cfg)
        self.session: aiohttp.ClientSession | None = None
        self.client: RobloxClient | None = None
        self.workers: WorkerManager | None = None
        self.hop: HopController | None = None


class ConfigPatch(BaseModel):
    min_value: str | None = None
    workers: int | None = None
    max_concurrency: int | None = None
    requests_per_second: float | None = None
    max_ping: int | None = None
    min_fps: float | None = None
    min_free_slots: int | None = None
    missing_metrics: str | None = None
    emit_discovered: bool | None = None
    notify_sound: bool | None = None
    bridge_enabled: bool | None = None

    @field_validator("min_value")
    @classmethod
    def _check_min(cls, value):
        if value is not None and parse_value(value) is None:
            raise ValueError("valor mínimo no interpretable")
        return value


def create_app(cfg: Config, bind_host: str = "127.0.0.1") -> FastAPI:
    ctx = Ctx(cfg)
    require_token = bind_host not in LOOPBACK

    @asynccontextmanager
    async def lifespan(_: FastAPI):
        connector = aiohttp.TCPConnector(limit=cfg.max_concurrency + 4,
                                         limit_per_host=cfg.max_concurrency + 4)
        ctx.session = aiohttp.ClientSession(connector=connector)
        ctx.client = RobloxClient(cfg, ctx.limiter, ctx.session)
        ctx.workers = WorkerManager(cfg, ctx.client, ctx.detector, ctx.aggregator)
        ctx.hop = HopController(cfg, ctx.aggregator, ctx.notifier, ctx.detector)

        async def on_change(record, _changed):
            ctx.notifier.publish("record", record.to_dict())

        async def on_expire(job_ids):
            ctx.notifier.publish("expired", {"job_ids": job_ids})

        ctx.aggregator.on_change = on_change
        ctx.aggregator.on_expire = on_expire
        if cfg.enable_discovery:
            await ctx.workers.start()
        try:
            yield
        finally:
            if ctx.hop:
                await ctx.hop.stop("apagado")
            if ctx.workers:
                await ctx.workers.stop()
            await ctx.notifier.shutdown()
            if ctx.session:
                await ctx.session.close()

    app = FastAPI(lifespan=lifespan, docs_url=None, redoc_url=None, openapi_url=None)
    app.state.ctx = ctx
    app.state.require_token = require_token

    @app.exception_handler(ApiError)
    async def _api_error(_: Request, exc: ApiError):
        return JSONResponse({"error": {"code": exc.code, "message": exc.message}}, status_code=exc.status)

    @app.exception_handler(Exception)
    async def _unhandled(_: Request, exc: Exception):
        log.exception("error no controlado")
        return JSONResponse({"error": {"code": "internal", "message": type(exc).__name__}}, status_code=500)

    async def auth(x_local_token: str = Header(default="")) -> None:
        if require_token and x_local_token != cfg.bridge_token:
            raise ApiError(401, "unauthorized", "token local requerido fuera de loopback")

    app.mount("/ui", StaticFiles(directory=UI_DIR), name="ui")

    @app.get("/")
    async def index():
        return FileResponse(UI_DIR / "index.html")

    @app.get("/api/state")
    async def state():
        return {
            "paused": cfg.paused,
            "workers": cfg.workers,
            "workers_alive": ctx.workers.alive if ctx.workers else 0,
            "rps_target": ctx.limiter.target_rps,
            "rps_measured": ctx.limiter.measured_rps,
            "blocked_for": ctx.limiter.blocked_for,
            "concurrency": ctx.limiter.concurrency,
            "stats": ctx.aggregator.ui_stats(),
            "hop": ctx.hop.status() if ctx.hop else {"running": False, "state": "idle"},
            "config": cfg.public_dict(),
            "bridge": {"enabled": cfg.bridge_enabled, "has_token": bool(cfg.bridge_token)},
            "auth_required": require_token,
            "findings": ctx.aggregator.snapshot(),
        }

    @app.get("/api/findings")
    async def findings(limit: int = 60, confirmed: bool = False, min_value: str | None = None):
        threshold = parse_value(min_value) if min_value else None
        if min_value and threshold is None:
            raise ApiError(422, "bad_min_value", f"valor no interpretable: {min_value}")
        return {"findings": ctx.aggregator.snapshot(min(200, max(1, limit)), confirmed, threshold)}

    @app.get("/api/bridge/info")
    async def bridge_info():
        return {"enabled": cfg.bridge_enabled, "token": cfg.bridge_token,
                "url": "http://127.0.0.1:8710/api/bridge/report", "place_id": cfg.place_id}

    @app.post("/api/config", dependencies=[Depends(auth)])
    async def patch_config(patch: ConfigPatch):
        backup = cfg.to_dict()
        old = (cfg.workers, cfg.max_concurrency, cfg.requests_per_second)
        for key, value in patch.model_dump(exclude_none=True).items():
            setattr(cfg, key, value)
        try:
            cfg.validate()
        except ConfigError as exc:
            for key, value in backup.items():
                setattr(cfg, key, value)
            raise ApiError(422, "invalid_config", str(exc))
        persisted = True
        try:
            cfg.save()
        except OSError as exc:
            persisted = False
            log.warning("no se pudo guardar la configuración: %s", exc)
        if (cfg.workers, cfg.max_concurrency, cfg.requests_per_second) != old:
            if ctx.workers and cfg.enable_discovery:
                await ctx.workers.stop()
                await ctx.workers.start()
            await ctx.limiter.retune(cfg.requests_per_second, cfg.max_concurrency)
        return {"ok": True, "persisted": persisted, "config": cfg.public_dict()}

    @app.post("/api/pause", dependencies=[Depends(auth)])
    async def pause():
        cfg.paused = True
        ctx.notifier.publish("paused", {"paused": True})
        return {"ok": True, "paused": True}

    @app.post("/api/resume", dependencies=[Depends(auth)])
    async def resume():
        cfg.paused = False
        ctx.notifier.publish("paused", {"paused": False})
        return {"ok": True, "paused": False}

    @app.post("/api/clear", dependencies=[Depends(auth)])
    async def clear():
        ctx.aggregator.clear()
        ctx.notifier.publish("cleared", {})
        return {"ok": True}

    @app.post("/api/hop/start", dependencies=[Depends(auth)])
    async def hop_start():
        if not ctx.hop:
            raise ApiError(503, "not_ready", "servicio arrancando")
        return ctx.hop.start()

    @app.post("/api/hop/stop", dependencies=[Depends(auth)])
    async def hop_stop():
        if not ctx.hop:
            raise ApiError(503, "not_ready", "servicio arrancando")
        return await ctx.hop.stop()

    @app.get("/api/join/{job_id}", dependencies=[Depends(auth)])
    async def join(job_id: str, launch: bool = False):
        if not is_job_id(job_id):
            raise ApiError(422, "bad_job", "JobId con formato inválido")
        record = ctx.aggregator.get_active(job_id)
        occupancy = record.occupancy.value if record else "unknown"
        link = join_handler.build(job_id, cfg.place_id, occupancy)
        if launch and link["protocol"]:
            link["open_result"] = join_handler.open_protocol(link["protocol"])
        return link

    @app.get("/api/health")
    async def health():
        return {"ok": True, "workers_alive": ctx.workers.alive if ctx.workers else 0,
                "rps_measured": ctx.limiter.measured_rps}

    @app.websocket("/ws")
    async def ws_endpoint(ws: WebSocket):
        origin = ws.headers.get("origin")
        if origin and require_token:
            if (urlparse(origin).hostname or "") not in LOOPBACK:
                await ws.close(code=1008)
                return
        await ctx.notifier.connect(ws)
        try:
            await ctx.notifier.send_hello(ws, {"paused": cfg.paused})
            while True:
                await ws.receive_text()
        except WebSocketDisconnect:
            pass
        except Exception:
            pass
        finally:
            await ctx.notifier.disconnect(ws)

    app.include_router(bridge.build_router(ctx))
    return app
