function connect() {
  if (ws && ws.readyState < 2) return;
  ws = new WebSocket(`${WS_PROTO}${location.host}/ws`);
  ws.onopen = () => { log('WS conectado'); refresh(); };
  ws.onmessage = (ev) => {
    let msg;
    try { msg = JSON.parse(ev.data); } catch { return; }
    if (msg.event === 'record') upsert(msg.data);
    else if (msg.event === 'expired') msg.data.job_ids.forEach(removeCard);
    else if (msg.event === 'cleared') { rendered.clear(); renderEmpty('Limpio.'); }
    else if (msg.event === 'hop') log(`hop ${msg.data.state}: ${msg.data.job_id || '-'}`);
    else if (msg.event === 'hop_done') log(`hop finalizado: ${msg.data.state} ${msg.data.reason || ''}`);
    else if (msg.event === 'bridge') log(`puente: ${msg.data.eggs} huevos en ${msg.data.job_id}`);
    else if (msg.event === 'paused') refresh();
  };
  ws.onclose = () => {
    clearTimeout(reconnectTimer);
    reconnectTimer = setTimeout(connect, 2000);
  };
  ws.onerror = () => { if (ws) ws.close(); };
}

